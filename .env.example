# Production: choose a long unique initial admin password and session secret.
# Never commit real credentials. The deploy script creates these on the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=true
DATA_DIR=/srv/insight-studio/shared/data
STATIC_DIR=/srv/insight-studio/current/frontend/dist
# Optional OpenRouter insights. New users: $1 lifetime model budget each.
# Admin: no application budget cap; provider balance and request limits apply.
# No raw rows are sent. The shared key is server-only.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro-0813
LLM_PROVIDER_ONLY=sail-research/fp4
# USD per million tokens; strict price ceilings verified 2026-10-27.
# If prices rise, calls stop rather than silently accepting a higher price.
LLM_INPUT_PER_MILLION_USD=0.45
LLM_OUTPUT_PER_MILLION_USD=0.8

# Local deployment script only; both must be configured explicitly.
# Use a DNS name pointing to your server, with TCP ports 80/443 reachable.
DEPLOY_HOST=
SITE_URL=
